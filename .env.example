# ==========================================
# Ghost QA Configuration
# ==========================================

# Application
APP_NAME=Ghost QA
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
DEMO_MODE=true

# Database
# For local development, use SQLite:
DATABASE_URL=sqlite:///./ghost_qa.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://ghost_qa:ghost_qa_pass@localhost:5432/ghost_qa

# GitHub
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_claude_api_key_here

# XAI (Grok) - alternative AI provider
XAI_API_KEY=xai-your_xai_key_here
GROK_MODEL=grok-4-1-fast-reasoning

# UiPath (modern Automation Cloud folder model)
UIPATH_CLIENT_ID=your_client_id
UIPATH_CLIENT_SECRET=your_client_secret
UIPATH_TENANT_NAME=DefaultTenant
UIPATH_ORG_ID=your_org_identifier
UIPATH_TEST_FOLDER=Shared/Ghost-QA
UIPATH_TEST_PROCESS=your_process_name
UIPATH_PAT=your_personal_access_token

# Slack (optional)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=ghost-qa-alerts

# Security
SECRET_KEY=your-secret-key-change-this-in-production
